{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Connect to a WARP charger",
        "description": "Enter the address of the charger. Leave username and password empty if the web interface is not password protected.",
        "data": {
          "host": "Host",
          "username": "Username",
          "password": "Password"
        },
        "data_description": {
          "host": "Hostname or IP address, optionally with a port (`warp3-abc.local:8080`).",
          "username": "Only needed if the charger's web interface requires a login.",
          "password": "Password of the web interface user."
        },
        "sections": {
          "advanced": {
            "name": "Advanced settings",
            "data": {
              "ssl": "Use HTTPS",
              "verify_ssl": "Verify SSL certificate"
            },
            "data_description": {
              "ssl": "Connect using HTTPS. Recommended when a password is set, as the login can otherwise be replayed on the network.",
              "verify_ssl": "Verify the certificate. Leave off for the charger's self-signed certificate."
            }
          }
        }
      },
      "zeroconf_confirm": {
        "title": "Set up {name}?",
        "description": "A WARP charger was found on your network. If it is password protected, enter the web interface credentials.",
        "data": {
          "username": "Username",
          "password": "Password"
        },
        "data_description": {
          "username": "Username of the web interface.",
          "password": "Password of the web interface user."
        }
      },
      "reauth_confirm": {
        "title": "Reauthenticate WARP charger",
        "description": "The credentials for {name} are missing or no longer valid. Enter the current web interface credentials.",
        "data": {
          "username": "Username",
          "password": "Password"
        },
        "data_description": {
          "username": "Username of the web interface.",
          "password": "Password of the web interface user."
        }
      },
      "reconfigure": {
        "title": "Reconfigure WARP charger",
        "description": "Change the address or credentials of this charger.",
        "data": {
          "host": "Host",
          "username": "Username",
          "password": "Password"
        },
        "data_description": {
          "host": "Hostname or IP address, optionally with a port (`warp3-abc.local:8080`).",
          "username": "Only needed if the charger's web interface requires a login.",
          "password": "Password of the web interface user."
        },
        "sections": {
          "advanced": {
            "name": "Advanced settings",
            "data": {
              "ssl": "Use HTTPS",
              "verify_ssl": "Verify SSL certificate"
            },
            "data_description": {
              "ssl": "Connect using HTTPS. Recommended when a password is set, as the login can otherwise be replayed on the network.",
              "verify_ssl": "Verify the certificate. Leave off for the charger's self-signed certificate."
            }
          }
        }
      }
