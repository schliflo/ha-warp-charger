{
  "domain": "tinkerforge_warp",
  "name": "Tinkerforge WARP",
  "after_dependencies": ["frontend", "http"],
  "codeowners": ["@schliflo"],
  "config_flow": true,
  "dependencies": ["tag"],
  "documentation": "https://github.com/schliflo/ha-warp-charger",
  "integration_type": "device",
  "iot_class": "local_push",
  "issue_tracker": "https://github.com/schliflo/ha-warp-charger/issues",
  "loggers": ["warp_charger"],
  "requirements": ["warp-charger==0.1.1"],
  "version": "0.2.0",
  "zeroconf": [
    {
      "type": "_http._tcp.local.",
      "properties": {
        "brand": "tinkerforge",
        "model": "warp*"
      }
    }
  ]
}
